# Copy to .env.local for local development. Set these in Vercel for deployment.
# Local development uses a persistent SQLite file; Vercel requires a remote URL.
TURSO_DATABASE_URL=file:.data/wbf.db
TURSO_AUTH_TOKEN=
# Connect a PRIVATE Vercel Blob store; never expose this token to the browser.
BLOB_READ_WRITE_TOKEN=
# Set to your public HTTPS domain in production.
WBF_SITE_URL=http://localhost:5173
# Generate a random 32+ character token for one-time administrator bootstrap.
SETUP_TOKEN=
# Test checkout stays disabled until all four values are configured.
RAZORPAY_TEST_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Outbox remains queued without these. Use your own verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_NOTIFICATION_EMAIL=
