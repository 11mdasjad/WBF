# Local Worker secrets: copy this file to .dev.vars (ignored by Git).
# Generate a random 32+ character token for one-time administrator bootstrap.
SETUP_TOKEN=
# Test checkout stays disabled until all four values are configured.
RAZORPAY_TEST_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Outbox remains queued without these. Use your own verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_NOTIFICATION_EMAIL=
